<%- include('partials/header') %>

<div style="max-width: 480px; margin: 2rem auto;">
    <div class="card">
        <h1 class="card-title" style="text-align: center;">User Login</h1>
        <p class="card-subtitle" style="text-align: center;">
            Exercise 1: Authenticate & Establish Session (<code>req.session.user</code>)
        </p>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <% if (message) { %>
            <div class="alert alert-<%= messageType || 'info' %>"><%= message %></div>
        <% } %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label for="username" class="form-label">Username</label>
                <input type="text" id="username" name="username" class="form-control" required placeholder="Enter your username" autofocus>
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" class="form-control" required placeholder="Enter your password">
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">Log In</button>
        </form>

        <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-color); font-size: 0.85rem; color: var(--text-secondary);">
            <strong>Demo Credentials:</strong><br>
            Username: <code>demo_user</code> | Password: <code>password123</code>
        </div>

        <p style="text-align: center; margin-top: 1.25rem; font-size: 0.9rem; color: var(--text-secondary);">
            Don't have an account? <a href="/register" style="color: var(--accent-blue); font-weight: 600;">Register here</a>
        </p>
    </div>
</div>

<%- include('partials/footer') %>
