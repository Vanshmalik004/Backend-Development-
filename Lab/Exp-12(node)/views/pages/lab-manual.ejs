  <!-- Theoretical Summary -->
  <section class="card" style="margin-bottom: 2rem;">
    <h2 class="card-title" style="margin-bottom: 1rem;">2. Theoretical Comparison: Multi-Threaded vs Event-Driven</h2>

    <div class="table-wrapper">
      <table class="modern-table">
        <thead>
          <tr>
            <th>Architecture Characteristic</th>
            <th>Traditional Multi-Threaded (e.g. Apache / Java Servlet)</th>
            <th>Node.js Event-Driven (Single-Threaded + Libuv)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Concurrency Model</strong></td>
            <td>Thread-per-request model (1 thread allocated per incoming socket)</td>
            <td>Single-threaded Event Loop handles all concurrent network connections</td>
          </tr>
          <tr>
            <td><strong>Memory Footprint</strong></td>
            <td>High overhead (1-2 MB stack memory allocated per thread)</td>
            <td>Minimal overhead (~few kilobytes per active connection)</td>
          </tr>
          <tr>
            <td><strong>I/O Blocking</strong></td>
            <td>Thread blocks on Disk/Network I/O operations</td>
            <td>Non-blocking asynchronous calls offloaded to Libuv C++ threadpool</td>
          </tr>
          <tr>
            <td><strong>Scalability Bottleneck</strong></td>
            <td>Thread exhaustion under high concurrent connection spikes (C10K problem)</td>
            <td>CPU-bound computations (mitigated via Worker Threads or clustering)</td>
          </tr>
          <tr>
            <td><strong>Templating / SSR</strong></td>
            <td>JSP / PHP parsed synchronously per page load</td>
            <td>EJS compiled to JavaScript functions and cached in V8 memory</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- EJS Tags Cheat Sheet -->
  <section class="card" style="margin-bottom: 2rem;">
    <h2 class="card-title" style="margin-bottom: 1rem;">3. EJS Templating Tags Syntax Matrix</h2>

    <div class="table-wrapper">
      <table class="modern-table">
        <thead>
          <tr>
            <th>EJS Tag Syntax</th>
            <th>Operation Name</th>
            <th>Behavior &amp; Security Characteristics</th>
            <th>Code Example</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>&lt;%= %&gt;</code></td>
            <td>Escaped Output</td>
            <td>Evaluates expression and HTML-escapes output (prevents Cross-Site Scripting / XSS)</td>
            <td><code>&lt;%= product.name %&gt;</code></td>
          </tr>
          <tr>
            <td><code>&lt;%- %&gt;</code></td>
            <td>Unescaped Output</td>
            <td>Outputs raw unescaped HTML. Essential for rendering nested partials or rich content</td>
            <td><code>&lt;%- include('partials/header') %&gt;</code></td>
          </tr>
          <tr>
            <td><code>&lt;% %&gt;</code></td>
            <td>Scriptlet (Execution)</td>
            <td>Executes JavaScript control-flow code (loops, conditionals) with zero HTML output</td>
            <td><code>&lt;% if (items.length &gt; 0) { %&gt;</code></td>
          </tr>
          <tr>
            <td><code>&lt;%# %&gt;</code></td>
            <td>Server Comment</td>
            <td>Server-side comment; stripped out entirely before reaching the HTTP response stream</td>
            <td><code>&lt;%# TODO: Add pagination %&gt;</code></td>
          </tr>
          <tr>
            <td><code>&lt;%_ _%&gt;</code></td>
            <td>Whitespace Slurping</td>
            <td>Removes leading and trailing whitespace around template scriptlet tags</td>
            <td><code>&lt;%_ items.forEach(i =&gt; { _%&gt;</code></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Interactive Viva-Voce Accordion -->
