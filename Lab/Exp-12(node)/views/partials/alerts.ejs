<%# EJS Alert Component Partial %>
<% if (typeof alert !== 'undefined' && alert && alert.message) { %>
  <div class="alert-banner alert-<%= alert.type || 'info' %>" id="flashAlert">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <span>
        <% if (alert.type === 'success') { %> ✅ 
        <% } else if (alert.type === 'danger') { %> ❌ 
        <% } else { %> ℹ️ 
        <% } %>
      </span>
      <span><%= alert.message %></span>
    </div>
    <button type="button" class="alert-dismiss" aria-label="Close Alert">&times;</button>
  </div>
<% } %>
