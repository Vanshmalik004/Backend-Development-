<%- include('partials/header') %>

<div class="form-container">
  <div class="detail-card">
    <div class="detail-header">
      <div>
        <span class="badge badge-<%= (note.category || 'other').toLowerCase() %>" style="margin-bottom: 8px;">
          <%= note.category || 'Other' %>
        </span>
        <h1 class="detail-title"><%= note.title %></h1>
      </div>
    </div>

    <div class="detail-body"><%= note.content %></div>

    <div class="detail-footer">
      <div style="color: var(--text-muted); font-size: 0.85rem;">
        <div>
          📅 <strong>Created:</strong>
          <%= note.createdAt ? new Date(note.createdAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : 'Unknown' %>
        </div>
        <% if (note.updatedAt) { %>
          <div style="margin-top: 4px;">
            🔄 <strong>Updated:</strong>
            <%= new Date(note.updatedAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %>
          </div>
        <% } %>
      </div>

      <div class="navbar-actions">
        <a href="/notes" class="btn btn-outline">⬅️ Back to Notes</a>
        <a href="/notes/<%= note._id %>/edit" class="btn btn-outline">✏️ Edit</a>
        <form
          action="/notes/<%= note._id %>/delete"
          method="POST"
          class="delete-form"
          data-title="<%= note.title %>"
          style="display: inline;"
        >
          <button type="submit" class="btn btn-danger">🗑️ Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
