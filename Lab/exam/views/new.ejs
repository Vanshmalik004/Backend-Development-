<%- include('partials/header') %>

<div class="form-container">
  <div class="form-card">
    <div class="form-header">
      <h1>➕ Add New Note</h1>
      <p class="dashboard-subtitle">Create and organize a new note in MongoDB</p>
    </div>

    <% if (errorMessage) { %>
      <div class="alert alert-danger">
        <span>⚠️ <%= errorMessage %></span>
      </div>
    <% } %>

    <form action="/notes" method="POST">
      <!-- Title Field (Compulsory & Validated) -->
      <div class="form-group">
        <label for="title" class="form-label">Note Title <span style="color: var(--danger);">*</span></label>
        <input
          type="text"
          id="title"
          name="title"
          class="form-control"
          placeholder="e.g. Backend Development Exam Notes"
          value="<%= typeof note !== 'undefined' && note.title ? note.title : '' %>"
          required
          autofocus
        >
      </div>

      <!-- Category Field -->
      <div class="form-group">
        <label for="category" class="form-label">Category</label>
        <select id="category" name="category" class="form-control">
          <% categories.forEach(cat => { %>
            <option
              value="<%= cat %>"
              <%= (typeof note !== 'undefined' && note.category === cat) ? 'selected' : (cat === 'Study' ? 'selected' : '') %>
            >
              <%= cat %>
            </option>
          <% }); %>
        </select>
      </div>

      <!-- Content Field (Compulsory & Validated) -->
      <div class="form-group">
        <label for="content" class="form-label">Note Content <span style="color: var(--danger);">*</span></label>
        <textarea
          id="content"
          name="content"
          class="form-control"
          placeholder="Write the full note content here..."
          required
        ><%= typeof note !== 'undefined' && note.content ? note.content : '' %></textarea>
      </div>

      <div class="form-actions">
        <a href="/notes" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary">💾 Save Note</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
